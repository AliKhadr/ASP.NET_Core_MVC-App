@page
@model RazorProjectAspNet.Pages.Categories.IndexModel

<h1>Category List</h1>

<div class="container">
    <div class="row pt-4 pb-3">
        <div class="col-6">
            <h2 class="text-primary">
                Category List
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-page="/Categories/Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Create New Category
            </a>
        </div>
    </div>
    
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Category Name</th>
                <th>Display Order</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model.CategoryList.OrderBy(u => u.DisplayOrder))
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.DisplayOrder</td>
                    <td class="text-center">
                        <div class="w-75 btn-group" role="group">
                            <a asp-page="/Categories/Edit" asp-route-id="@category.Id" class="btn btn-primary btn-sm mx-2">
                                <i class="bi bi-pencil-square me-2"></i>Edit
                            </a>
                            <a asp-page="/Categories/Delete" asp-route-id="@category.Id" class="btn btn-danger btn-sm mx-2">
                                <i class="bi bi-trash-fill me-2"></i>Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
    
